# Copy to .env (git ignores it) and fill in. Never commit real keys.

# Google AI Studio -> Get API key
GEMINI_API_KEY=
# Optional; run `python scripts/draft_report.py --list-models` to see what your key can use
GEMINI_MODEL=gemini-3.6-flash
# Optional latency controls (defaults shown): thinking minimal|low|medium|high; image resolution LOW|MEDIUM|HIGH|ULTRA_HIGH
# GEMINI_THINKING_LEVEL=low
# GEMINI_MEDIA_RESOLUTION=MEDIA_RESOLUTION_MEDIUM
# GEMINI_TIMEOUT=180
# GEMINI_MAX_ATTEMPTS=4

# Langfuse Cloud -> your project -> Settings -> API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU region: https://cloud.langfuse.com   US region: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
